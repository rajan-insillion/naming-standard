                    "age_13_18": {"type": "bool"},
                    "over_18":   {"type": "bool"}
                },
                "extent_of_sponsorship": {"type": "string"}
            }
        },
        "structural_alterations_contemplated": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "demolition_exposure": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "joint_ventures": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "leased_employees": {
            "opted": {"type": "YN"},
            "lease_to": {
                "description":           {"type": "string"},
                "workers_comp_carried":  {"type": "YN"}
            },
            "lease_from": {
                "description":           {"type": "string"},
                "workers_comp_carried":  {"type": "YN"}
            }
        },
        "labor_interchange": {
            "opted": {"type": "YN"},
            "description": {"type": "string", "description": "labor interchange with any other business or subsidiaries"}
        },
        "day_care_facilities": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "crimes_on_premises": {
            "opted": {"type": "YN"},
