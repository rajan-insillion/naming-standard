{
    "_app_form_name": "ACORD 126",
    "_app_form_version": "2025/03",
    "application_date": {"type": "date"},
    "cust_ref_id": {"type": "string", "description": "agency/broker/customer reference id"},
    "policy_start_date": {"type": "date"},
    "policy_start_time": {"type": "string"},

    "agency": {
        "name":      {"type": "agency"},
        "address_1": {"type": "string"},
        "address_2": {"type": "string"},
        "city":      {"type": "string"},
        "state":     {"type": "state"},
        "zipcode":   {"type": "zip"}
    },
    "carrier": {
        "name":      {"type": "carrier"},
        "naic_code": {"type": "naic"},
        "policy_no": {"type": "policy_no"}
    },
    "insured": {
        "name": {"type": "company", "description": "first/primary named insured, must match ACORD 125"}
    },
    "coverage": {
        "policy_type_@": {
            "occurrence":                  {"type": "bool"},
            "claims_made":                 {"type": "bool"},
            "owners_contractors_protective": {"type": "bool", "description": "The upstream owner or GC"}
        },
        "aggregate_limit_applies_per_@": {
            "policy":   {"type": "bool"},
            "project":  {"type": "bool"},
            "location": {"type": "bool"},
            "other": {"type": "bool"}
        },
        "limits": {
            "general_aggregate":                    {"type": "currency"},
            "products_completed_ops_aggregate":     {"type": "currency"},
            "personal_advertising_injury":          {"type": "currency"},
            "each_occurrence":                      {"type": "currency"},
            "damage_to_rented_premises":            {"type": "currency", "description": "per occurrence"},
            "medical_expense":                      {"type": "currency", "description": "any one person"},
            "employee_benefits":                    {"type": "currency"}
        },
        "deductibles": {
            "bodily_injury":     {"type": "currency"},
            "property_damage":   {"type": "currency"},
            "deductible_per_@": {
                "per_claim":      {"type": "bool"},
                "per_occurrence": {"type": "bool"}
            }
        },
        "premiums": {
            "premises_operations": {"type": "currency"},
            "products":            {"type": "currency"},
            "other":               {"type": "currency"},
            "total":               {"type": "currency"}
        },
        "other_coverages_endorsements": {"type": "string", "description": "hired/non-owned auto, restrictions, other endorsements narrative"},
        "wisconsin_auto": {
            "um_uim_coverage_available":    {"type": "bool"},
            "medical_payments_available":   {"type": "bool"}
        }
    },
    "schedule_of_hazards_^": {
        "loc_no":                   {"type": "string"},
        "haz_no":                   {"type": "string"},
        "class_code":               {"type": "string"},
        "classification_description": {"type": "string"},
        "premium_basis_@": {
            "gross_sales":   {"type": "bool", "description": "S - per $1,000/sales"},
            "payroll":       {"type": "bool", "description": "P - per $1,000/pay"},
            "area":          {"type": "bool", "description": "A - per 1,000/sq ft"},
            "total_cost":    {"type": "bool", "description": "C - per $1,000/cost"},
            "admissions":    {"type": "bool", "description": "M - per 1,000/admissions"},
            "unit":          {"type": "bool", "description": "U - per unit"},
            "other":         {"type": "bool", "description": "T - other"}
        },
        "territory":                {"type": "string"},
        "exposure":                 {"type": "number"},
        "prem_ops_rate":            {"type": "number"},
        "products_rate":            {"type": "number"},
        "prem_ops_premium":         {"type": "currency"},
        "products_premium":         {"type": "currency"}
    },

    "claims_made": {
        "proposed_retroactive_date":                      {"type": "date"},
        "entry_date_uninterrupted_claims_made_coverage":  {"type": "date"},
        "prior_coverage_exclusion": {
            "opted": {"type": "YN"},
            "description": {"type": "string", "description": "products, work, accidents, or locations excluded/uninsured/self-insured from any previous coverage"}
        },
        "tail_coverage_purchased": {"type": "YN"}
    },
    "employee_benefits_liability": {
        "deductible_per_claim":               {"type": "currency"},
        "employee_count":                     {"type": "number"},
        "employees_covered_by_benefits_count": {"type": "number"},
        "retroactive_date":                   {"type": "date"}
    },

    "contractors": {
        "qa": {
            "draws_plans_designs_specs": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "blasting_or_explosives": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "excavation_tunneling_underground": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "subcontractors_lower_limits": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "subcontractors_without_coi": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "leases_equipment_to_others": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "full_time_staff_count":  {"type": "number"},
            "part_time_staff_count":  {"type": "number"},
            "subcontracted_work_percent": {"type": "number", "description": "percentage of work subcontracted"},
            "subcontracted_work_description": {"type": "string"},
            "subcontracted_work_amount": {"type": "currency", "description": "paid to subcontractors"}
        }
    },

    "products_completed_operations": {
        "product_^": {
            "name":               {"type": "string"},
            "annual_gross_sales": {"type": "currency"},
            "unit_count":         {"type": "number"},
