            "expected_life":    {"type": "string", "description": "future number of years the product expected to be in use"},
            "intended_use":       {"type": "string"},
            "principal_components": {"type": "string"}
        },
        "qa": {
            "installs_services_demonstrates": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "foreign_products": {
                "opted": {"type": "YN"},
                "description": {"type": "string", "description": "if YES attach ACORD 815"}
            },
            "research_development_new_products": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "guarantees_warranties_hold_harmless": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "aircraft_space_related": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "recalled_discontinued_changed": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "sold_repackaged_under_applicant_label": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "sold_under_label_of_others": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "vendors_coverage_required": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            },
            "named_insured_sells_to_other_named_insured": {
                "opted": {"type": "YN"},
                "description": {"type": "string"}
            }
        }
    },
    "additional_interest_^": {
        "interest_type_@": {
            "additional_insured":   {"type": "bool"},
            "employee_as_lessor":   {"type": "bool"},
            "lenders_loss_payable": {"type": "bool"},
            "lienholder":           {"type": "bool"},
            "loss_payee":           {"type": "bool"},
            "mortgagee":            {"type": "bool"}
        },
        "rank":              {"type": "string"},
        "evidence_@": {
            "certificate": {"type": "bool"},
            "other":       {"type": "bool"}
        },
        "name":              {"type": "string"},
        "address_1":         {"type": "string"},
        "address_2":         {"type": "string"},
        "city":              {"type": "string"},
        "state":             {"type": "state"},
        "zipcode":           {"type": "zip"},
        "reference_loan_no": {"type": "string"},
        "location":          {"type": "string"},
        "building":          {"type": "string"},
        "item_class":        {"type": "string"},
        "item_no":           {"type": "string"},
        "item_description":  {"type": "string"}
    },

    "general_information": {
        "medical_facilities_or_professionals": {
            "opted": {"type": "YN"},
