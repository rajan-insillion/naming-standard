        },
        "watercraft_docks_floats": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "parking_facilities": {
            "opted": {"type": "YN"},
            "fee_charged": {"type": "YN"}
        },
        "recreation_facilities": {
            "opted": {"type": "YN"},
            "description": {"type": "string"}
        },
        "lodging_operations": {
            "opted": {"type": "YN"},
